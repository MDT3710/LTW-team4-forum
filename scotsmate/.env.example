# Cấu hình gửi email đặt lại mật khẩu thật qua Gmail SMTP (tùy chọn).
# Sao chép file này thành ".env" trong thư mục scotsmate/ rồi điền Gmail + App Password 16 ký tự.
# Nếu chưa có file ".env", hệ thống tự động in link đặt lại mật khẩu ra terminal chạy runserver.

EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
